# ── Python ────────────────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.egg-info/
.pytest_cache/

# ── Environment / Secrets ─────────────────────────────────────────────────────
backend/.env
# The real server file (DB password, service-role key, SMTP password). Only
# .env.production.example belongs in the repo — never a copy pulled off the box.
backend/.env.production
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.test
frontend/.env.production

# ── Local database ────────────────────────────────────────────────────────────
backend/safetec_core.db
backend/safetec_core.db-shm
backend/safetec_core.db-wal
*.db
*.db-shm
*.db-wal

# ── Uploaded / generated files ────────────────────────────────────────────────
backend/static/*
# …but ship the bundled default letterheads so PDFs/statements render them in prod
!backend/static/letterheads/

# ── Node.js ───────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
backend/logs/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/
