# ── Database ───────────────────────────────────────────────────────────────────
# Supabase connection pooler URL (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# ── URLs ───────────────────────────────────────────────────────────────────────
# Before domain:  http://<HETZNER_IP>:8000
# After domain:   https://api.yourdomain.co.za
BASE_URL=http://<HETZNER_IP>:8000
FRONTEND_URL=https://safetec-core.vercel.app

# ── Linear (feedback widget) ───────────────────────────────────────────────────
LINEAR_API_TOKEN=REPLACE_WITH_LINEAR_API_TOKEN
LINEAR_TEAM_ID=REPLACE_WITH_LINEAR_TEAM_ID

# ── SMTP (Nexus Portal) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.portal.nexus-internal.co.za
SMTP_PORT=465
SMTP_USER=system@portal.nexus-internal.co.za
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=system@portal.nexus-internal.co.za
SMTP_TLS=false
