# ── Backend API URL ───────────────────────────────────────────────────────────
# Leave blank (or omit this file) in local dev — Vite proxies /api to localhost:8001.
# Set this in your hosting platform (Vercel / Railway) environment variables for production.
# VITE_API_URL=https://your-backend.railway.app

# ── Linear Help Guide ─────────────────────────────────────────────────────────
# Public share link to your Linear "How To" document.
# The Help button (?) will be hidden if this is not set.
# VITE_LINEAR_HELP_DOC_URL=https://linear.app/your-team/document/...
