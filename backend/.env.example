# ── Database ──────────────────────────────────────────────────────────────────
# Production (PostgreSQL / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local dev (SQLite):
DATABASE_URL=sqlite:///./safetec_core.db

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Supabase Storage (for logo uploads in production) ─────────────────────────
# Leave blank when using local SQLite dev — local file storage is used instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Backend base URL ──────────────────────────────────────────────────────────
# Used to build absolute logo URLs in local dev. Not needed in production.
# BASE_URL=http://localhost:8001
