# ── Database ───────────────────────────────────────────────────────────────────
# Supabase connection pooler URL (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# ── URLs ───────────────────────────────────────────────────────────────────────
# Before domain:  http://<HETZNER_IP>:8000
# After domain:   https://api.yourdomain.co.za
BASE_URL=http://<HETZNER_IP>:8000
FRONTEND_URL=https://safetec-core.vercel.app

# ── Supabase Storage (private document buckets) ────────────────────────────────
# REQUIRED in production. Every storage path — entity logos (entity-branding),
# customer-invoice attachments (invoices), supplier-invoice documents and monthly
# supplier statements (supplier-invoices) — resolves the same way:
#     IS_LOCAL = DATABASE_URL.startswith("sqlite") or not SUPABASE_URL
# so if SUPABASE_URL is blank the app does NOT fail: it silently falls back to
# writing inside the container at /app/uploads, which has no volume mounted and is
# wiped by the next `docker compose up --build`. Uploaded documents are then lost
# and previously-stored ones 404. Set both keys.
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ── Linear (feedback widget) ───────────────────────────────────────────────────
LINEAR_API_TOKEN=REPLACE_WITH_LINEAR_API_TOKEN
LINEAR_TEAM_ID=REPLACE_WITH_LINEAR_TEAM_ID

# ── SMTP (Nexus Portal) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.portal.nexus-internal.co.za
SMTP_PORT=465
SMTP_USER=system@portal.nexus-internal.co.za
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=system@portal.nexus-internal.co.za
SMTP_TLS=false
